# =============================================================================
# Colombo Restaurant Pipeline — Environment Configuration
# =============================================================================
# Copy to .env and fill in values.
# In production / containers, set these as real environment variables.

# ── Google Places API (required for --collect) ────────────────────────────────
GOOGLE_API_KEY=your_key_here

# ── Data paths (optional — all default to pipeline-root-relative paths) ───────
# Override on remote servers where the working directory may differ.
#
# Raw input / output
# OUTPUT_FILE=/data/colombo_restaurants.csv
# HISTORICAL_FILE=/data/historical_ratings.csv
# PARQUET_DIR=/data/restaurants.parquet
#
# Processed data
# PIPELINE_RAW_CSV=/data/raw/colombo_restaurants_raw.csv
# PIPELINE_CLEAN_CSV=/data/processed/colombo_restaurants_clean.csv
# PIPELINE_ANALYTICS_DIR=/data/processed/analytics
# PIPELINE_VIZ_DIR=/data/processed/visualizations
#
# Final artefacts
# PIPELINE_FINAL_CSV=/data/final/colombo_restaurants_final.csv
# PIPELINE_FEATURES_CSV=/data/final/colombo_restaurants_features.csv
# PIPELINE_RECS_CSV=/data/final/all_user_recommendations.csv
# PIPELINE_METRICS_JSON=/data/final/evaluation_metrics.json
#
# Model outputs
# PIPELINE_FEATURE_PIPELINE=/models/feature_pipeline
# PIPELINE_ALS_MODEL_DIR=/models/als_model

# ── ALS hyper-parameters (optional overrides) ─────────────────────────────────
# ALS_RANK=10
# ALS_ITER=10
# ALS_REG=0.1
# TRAIN_SEED=42
